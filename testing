<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>VEXSAKEN — Roblox Scripts</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #07050d;
            --bg2: #0d0817;
            --card: rgba(20, 12, 34, .78);
            --purple: #9b5cff;
            --purple2: #6d28d9;
            --purple3: #c084fc;
            --text: #f7f3ff;
            --muted: #a79bb9;
            --green: #45e58b;
            --border: rgba(177, 104, 255, .18);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at 50% -10%, rgba(125, 45, 255, .24), transparent 38%),
                radial-gradient(circle at 90% 50%, rgba(104, 36, 200, .10), transparent 35%),
                var(--bg);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            opacity: .35;
            background-image:
                linear-gradient(rgba(255,255,255,.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px);
            background-size: 50px 50px;
            mask-image: linear-gradient(to bottom, black, transparent 80%);
        }

        .orb {
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: .12;
            pointer-events: none;
            animation: floatOrb 8s ease-in-out infinite alternate;
        }

        .orb.one {
            background: #8b5cf6;
            top: 10%;
            left: -150px;
        }

        .orb.two {
            background: #c026d3;
            right: -160px;
            top: 55%;
            animation-delay: 2s;
        }

        @keyframes floatOrb {
            from {
                transform: translateY(-25px) translateX(0);
            }
            to {
                transform: translateY(35px) translateX(30px);
            }
        }

        /* HEADER */

        header {
            width: 100%;
            padding: 18px 5%;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(18px);
            background: rgba(7,5,13,.72);
            border-bottom: 1px solid rgba(255,255,255,.04);
        }

        .nav {
            max-width: 1250px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: white;
        }

        .brand img {
            width: 42px;
            height: 42px;
            object-fit: contain;
            border-radius: 10px;
            filter: drop-shadow(0 0 15px rgba(155,92,255,.45));
        }

        .brand-name {
            font-family: "Orbitron", sans-serif;
            font-weight: 900;
            font-size: 20px;
            letter-spacing: 2px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
            padding: 5px;
            border: 1px solid rgba(255,255,255,.07);
            background: rgba(255,255,255,.025);
            border-radius: 14px;
        }

        .tab {
            position: relative;
            border: 0;
            background: transparent;
            color: #91869f;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: .3s ease;
        }

        .tab:hover {
            color: white;
        }

        .tab.active {
            color: white;
            background: linear-gradient(135deg, rgba(155,92,255,.25), rgba(109,40,217,.14));
            box-shadow: inset 0 0 0 1px rgba(155,92,255,.15);
        }

        .discord-btn {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: white;
            text-decoration: none;
            padding: 11px 17px;
            border-radius: 12px;
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            box-shadow: 0 8px 30px rgba(124,58,237,.22);
            font-weight: 800;
            transition: .25s ease;
            white-space: nowrap;
        }

        .discord-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(147,51,234,.35);
        }

        .discord-icon {
            width: 19px;
            height: 19px;
            fill: currentColor;
        }

        /* PAGE */

        main {
            max-width: 1250px;
            margin: auto;
            padding: 75px 5% 100px;
        }

        .page {
            display: none;
            animation: pageIn .5s ease forwards;
        }

        .page.active {
            display: block;
        }

        @keyframes pageIn {
            from {
                opacity: 0;
                transform: translateX(45px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hero {
            text-align: center;
            max-width: 850px;
            margin: 0 auto 55px;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border: 1px solid rgba(155,92,255,.2);
            background: rgba(155,92,255,.08);
            border-radius: 999px;
            color: #c8a8ff;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.3px;
            margin-bottom: 18px;
        }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 12px rgba(69,229,139,.8);
        }

        h1 {
            font-family: "Orbitron", sans-serif;
            font-size: clamp(44px, 8vw, 86px);
            line-height: .95;
            letter-spacing: 3px;
            margin-bottom: 22px;
            background: linear-gradient(135deg, #fff, #c084fc 48%, #7c3aed);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 50px rgba(139,92,246,.12);
        }

        .hero p {
            color: var(--muted);
            line-height: 1.8;
            font-size: 16px;
            max-width: 680px;
            margin: auto;
        }

        .hero-buttons {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 28px;
            flex-wrap: wrap;
        }

        .primary-btn,
        .secondary-btn {
            border: 0;
            padding: 13px 20px;
            border-radius: 12px;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
            transition: .25s ease;
        }

        .primary-btn {
            color: white;
            background: linear-gradient(135deg, #8b5cf6, #6d28d9);
            box-shadow: 0 10px 35px rgba(109,40,217,.25);
        }

        .secondary-btn {
            color: #d6c7e9;
            border: 1px solid rgba(255,255,255,.08);
            background: rgba(255,255,255,.035);
        }

        .primary-btn:hover,
        .secondary-btn:hover {
            transform: translateY(-2px);
        }

        /* GAME SUPPORT */

        .support-title {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            font-size: 12px;
            color: #a99bb9;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 800;
        }

        .support-title .dot {
            width: 8px;
            height: 8px;
        }

        .game-marquee {
            width: 100%;
            overflow: hidden;
            position: relative;
            margin-bottom: 65px;
            padding: 8px 0 15px;
        }

        .game-track {
            display: flex;
            width: max-content;
            gap: 18px;
            animation: slideGames 28s linear infinite;
        }

        .game-marquee:hover .game-track {
            animation-play-state: paused;
        }

        @keyframes slideGames {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-50%);
            }
        }

        .game-chip {
            width: 245px;
            height: 115px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
            border-radius: 17px;
            border: 1px solid rgba(255,255,255,.08);
            background: #100a1a;
            box-shadow: 0 15px 35px rgba(0,0,0,.25);
        }

        .game-chip img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .58;
            transition: .4s ease;
        }

        .game-chip:hover img {
            transform: scale(1.08);
            opacity: .75;
        }

        .game-chip::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(transparent 15%, rgba(5,3,10,.9));
        }

        .game-chip-name {
            position: absolute;
            z-index: 2;
            bottom: 13px;
            left: 15px;
            font-weight: 800;
            font-size: 15px;
        }

        .game-chip-status {
            position: absolute;
            z-index: 2;
            top: 12px;
            right: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 9px;
            font-weight: 900;
            color: #b9fbd2;
            padding: 5px 8px;
            border-radius: 999px;
            background: rgba(7,20,14,.75);
            border: 1px solid rgba(69,229,139,.15);
        }

        .game-chip-status .dot {
            width: 5px;
            height: 5px;
        }

        /* SCRIPT GRID */

        .section-heading {
            text-align: center;
            margin-bottom: 28px;
        }

        .section-heading h2 {
            font-family: "Orbitron", sans-serif;
            font-size: 25px;
            margin-bottom: 9px;
        }

        .section-heading p {
            color: var(--muted);
            font-size: 14px;
        }

        .scripts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .script-card {
            position: relative;
            overflow: hidden;
            background:
                linear-gradient(145deg, rgba(26,16,42,.9), rgba(12,8,20,.9));
            border: 1px solid var(--border);
            border-radius: 20px;
            min-width: 0;
            transition: .3s ease;
        }

        .script-card:hover {
            transform: translateY(-4px);
            border-color: rgba(155,92,255,.4);
            box-shadow: 0 20px 50px rgba(0,0,0,.3);
        }

        .script-banner {
            height: 170px;
            position: relative;
            overflow: hidden;
        }

        .script-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .62;
            transition: .5s ease;
        }

        .script-card:hover .script-banner img {
            transform: scale(1.05);
        }

        .script-banner::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(to bottom, transparent 10%, rgba(11,6,18,.97) 100%);
        }

        .status {
            position: absolute;
            z-index: 3;
            top: 13px;
            right: 13px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 10px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
            color: #b9fbd2;
            background: rgba(7,17,12,.8);
            border: 1px solid rgba(69,229,139,.2);
        }

        .status .dot {
            width: 6px;
            height: 6px;
        }

        .script-title {
            position: absolute;
            z-index: 3;
            left: 19px;
            bottom: 15px;
            font-size: 21px;
            font-weight: 900;
        }

        .script-body {
            padding: 18px;
        }

        .script-description {
            color: #9e93aa;
            font-size: 13px;
            line-height: 1.65;
            margin-bottom: 15px;
        }

        .code-box {
            width: 100%;
            min-height: 90px;
            padding: 14px;
            padding-right: 14px;
            border-radius: 12px;
            background: rgba(0,0,0,.3);
            border: 1px solid rgba(255,255,255,.06);
            color: #cbb8df;
            font-family: "Courier New", monospace;
            font-size: 11px;
            line-height: 1.6;
            overflow-x: auto;
            overflow-y: hidden;
            white-space: pre-wrap;
            word-break: break-all;
            margin-bottom: 13px;
        }

        .card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .copy-btn,
        .play-btn {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
            min-height: 43px;
            border-radius: 11px;
            border: 0;
            cursor: pointer;
            font-weight: 800;
            transition: .25s ease;
            text-decoration: none;
            font-size: 12px;
        }

        .copy-btn {
            color: white;
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
        }

        .play-btn {
            color: #ddd2ea;
            background: rgba(255,255,255,.045);
            border: 1px solid rgba(255,255,255,.08);
        }

        .copy-btn:hover,
        .play-btn:hover {
            transform: translateY(-2px);
        }

        .copy-btn.copied {
            background: linear-gradient(135deg, #16a34a, #15803d);
        }

        /* GAMES PAGE */

        .games-large {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .large-game {
            position: relative;
            height: 260px;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

        .large-game img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s ease;
            opacity: .65;
        }

        .large-game:hover img {
            transform: scale(1.06);
            opacity: .8;
        }

        .large-game::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(transparent 15%, rgba(7,4,12,.95));
        }

        .large-game-content {
            position: absolute;
            z-index: 2;
            left: 22px;
            right: 22px;
            bottom: 20px;
        }

        .large-game-content h3 {
            font-size: 23px;
            margin-bottom: 7px;
        }

        .large-game-content p {
            color: #aaa0b3;
            font-size: 13px;
            margin-bottom: 13px;
        }

        /* PREMIUM */

        .premium-box {
            max-width: 750px;
            margin: 0 auto;
            padding: 45px;
            text-align: center;
            border: 1px solid rgba(155,92,255,.22);
            border-radius: 25px;
            background:
                radial-gradient(circle at top, rgba(139,92,246,.16), transparent 50%),
                rgba(18,10,29,.8);
            box-shadow: 0 30px 80px rgba(0,0,0,.3);
        }

        .premium-icon {
            width: 60px;
            height: 60px;
            display: grid;
            place-items: center;
            margin: 0 auto 20px;
            border-radius: 17px;
            background: linear-gradient(135deg, #a855f7, #6d28d9);
            font-size: 27px;
            box-shadow: 0 12px 40px rgba(139,92,246,.3);
        }

        .premium-box h2 {
            font-family: "Orbitron", sans-serif;
            font-size: 29px;
            margin-bottom: 12px;
        }

        .premium-box p {
            color: var(--muted);
            line-height: 1.8;
            margin-bottom: 25px;
        }

        .feature-list {
            display: grid;
            gap: 10px;
            text-align: left;
            max-width: 450px;
            margin: 0 auto 25px;
        }

        .feature {
            padding: 12px 15px;
            border-radius: 11px;
            background: rgba(255,255,255,.03);
            color: #c7bdd2;
            font-size: 13px;
        }

        .feature span {
            color: var(--green);
            margin-right: 8px;
        }

        /* FOOTER */

        footer {
            border-top: 1px solid rgba(255,255,255,.05);
            padding: 25px 5%;
            text-align: center;
            color: #70687a;
            font-size: 12px;
        }

        /* RESPONSIVE */

        @media (max-width: 850px) {
            header {
                padding: 13px 4%;
            }

            .nav {
                flex-wrap: wrap;
                justify-content: center;
            }

            .brand {
                width: 100%;
                justify-content: center;
            }

            .tabs {
                order: 2;
            }

            .discord-btn {
                order: 3;
            }

            main {
                padding-top: 55px;
            }

            .scripts-grid,
            .games-large {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 520px) {
            .tab {
                padding: 9px 12px;
                font-size: 12px;
            }

            .discord-btn {
                padding: 10px 13px;
                font-size: 11px;
            }

            .hero {
                margin-bottom: 40px;
            }

            .hero p {
                font-size: 14px;
            }

            .card-actions {
                grid-template-columns: 1fr;
            }

            .premium-box {
                padding: 30px 20px;
            }

            .game-chip {
                width: 215px;
            }
        }
    </style>
</head>

